APP_NAME="ERP CFA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=erp_cfa
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# EN PRODUCTION (HTTPS) : passer à true pour que le cookie de session ne parte
# jamais en clair. Laisser vide/false en local (http), sinon plus de connexion.
SESSION_SECURE_COOKIE=false

# Reverse-proxy de production : IP(s) du proxy, séparées par des virgules
# (ex. 10.0.0.1,10.0.0.2). Laisser « * » en local / derrière un tunnel de partage.
TRUSTED_PROXIES=*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Signature électronique des contrats (EPIC-08) ───
# Prestataire de signature : « simulation » (démo, sans valeur probante),
# « none » (désactivé, signature manuelle), ou un prestataire eIDAS réel à venir.
# « simulation » (défaut, démo/dev, aucune valeur légale) | « yousign » (réel) | « none »
SIGNATURE_DRIVER=simulation
SIGNATURE_EXPIRATION_JOURS=14
SIGNATURE_WEBHOOK_SECRET=

# Yousign (API v3) — https://developers.yousign.com/
# Laisser vide tant qu'aucun abonnement n'est souscrit : sans clé, le driver se
# déclare inactif et la signature électronique reste simplement indisponible.
# Mise en service : renseigner la clé, déclarer le webhook chez Yousign vers
# /webhooks/signature/yousign, recopier son secret, puis SIGNATURE_DRIVER=yousign.
YOUSIGN_API_KEY=
YOUSIGN_SANDBOX=true
YOUSIGN_WEBHOOK_SECRET=
# electronic_signature | advanced_electronic_signature | qualified_electronic_signature
YOUSIGN_NIVEAU=electronic_signature
YOUSIGN_AUTHENTIFICATION=no_otp

# ─── LivretRS : génération automatique des livrables (Phase 2) ───
# URL du service de génération (moteur core/ exposé en HTTP). Vide = désactivé.
LIVRETRS_URL=
LIVRETRS_TIMEOUT=180

# Identité du CFA (injectée dans les livrables générés)
CFA_NOM="CFA V2S"
CFA_RAISON_SOCIALE=
CFA_SIRET=
CFA_SIREN=
CFA_NAF=
CFA_NDA=
CFA_UAI=
CFA_ADRESSE=
CFA_CODE_POSTAL=
CFA_VILLE=
CFA_TELEPHONE=
CFA_EMAIL=
CFA_WEBSITE=
CFA_REPRESENTANT_NOM=
CFA_REPRESENTANT_PRENOM=
CFA_REPRESENTANT_FONCTION="Directeur"
CFA_REF_PEDAGOGIQUE_NOM=
CFA_REF_PEDAGOGIQUE_PRENOM=
CFA_REF_HANDICAP_NOM=
CFA_REF_HANDICAP_PRENOM=

# API La Bonne Alternance (prospection alternance) — usage non lucratif
# Clé Bearer à obtenir sur https://api.apprentissage.beta.gouv.fr (espace développeurs)
LBA_API_KEY=
LBA_CENTER_LAT=48.8566
LBA_CENTER_LON=2.3522
LBA_DEFAULT_RADIUS=30
# En dev Windows, si "cURL error 60" (bundle CA manquant) : LBA_VERIFY_SSL=false (dev uniquement)
LBA_VERIFY_SSL=true
